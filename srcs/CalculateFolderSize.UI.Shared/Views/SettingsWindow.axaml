<Window x:Class="CalculateFolderSize.UI.Shared.Views.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CalculateFolderSize.UI.Shared.ViewModels"
        xmlns:models="using:CalculateFolderSize.UI.Shared.Models"
        xmlns:shared="using:CalculateFolderSize.UI.Shared"
        xmlns:views="using:CalculateFolderSize.UI.Shared.Views"
        x:DataType="vm:SettingsWindowViewModel"
        Title="设置"
        Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">

  <Window.Resources>
    <shared:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
    <ResourceDictionary x:Key="ThemeColors">
      <ResourceDictionary.ThemeDictionaries>

        <!-- 浅色主题 -->
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F2F5FA"/>
          <SolidColorBrush x:Key="TitleForegroundBrush" Color="#1E5FCC"/>
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#2E6FDB"/>
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>
        </ResourceDictionary>

        <!-- 深色主题 -->
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#1A1D24"/>
          <SolidColorBrush x:Key="TitleForegroundBrush" Color="#7FB0FF"/>
          <SolidColorBrush x:Key="PrimaryButtonBackgroundBrush" Color="#4C8DF6"/>
          <SolidColorBrush x:Key="PrimaryButtonForegroundBrush" Color="#FFFFFF"/>
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Panel>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">

      <!-- Core 计算设置 -->
      <TextBlock Text="计算设置 (保存后重启生效)" FontWeight="Bold"
                 Foreground="{DynamicResource TitleForegroundBrush}"/>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <TextBlock Text="显示小数位数:" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Column="1" Value="{Binding DecimalPlaces}" Minimum="0" Maximum="6" Increment="1" FormatString="0"
                       ToolTip.Tip="文件大小显示保留的小数位数 (0-6). 例如 2 位时显示 1.23 GB, 0 位时显示 1 GB, 保存后重启生效"/>
        <TextBlock Grid.Row="1" Text="每任务最大并行度:" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding MaxDegreeOfParallelism}" Minimum="1" Maximum="128" Increment="1" FormatString="0"
                       ToolTip.Tip="每个计算任务同时扫描文件的最大线程数. 提高数值可加快扫描速度, 但会占用更多 CPU 与内存, 保存后重启生效"/>
        <TextBlock Grid.Row="2" Text="捕获子项:" VerticalAlignment="Center"/>
        <CheckBox Grid.Row="2" Grid.Column="1" Content="启用 (用于结果窗口浏览)" IsChecked="{Binding CaptureChildren}"
                  ToolTip.Tip="扫描时保存每个子文件夹的大小明细, 用于在结果窗口中逐层浏览. 会额外占用内存与磁盘空间, 保存后重启生效"/>
      </Grid>
      <Button Content="{Binding SaveButtonText}" Command="{Binding SaveCoreOptionsCommand}" HorizontalAlignment="Left"
              Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>

      <Separator/>

      <!-- UI 配置 -->
      <TextBlock Text="UI 配置 (保存后重启生效)" FontWeight="Bold"
                 Foreground="{DynamicResource TitleForegroundBrush}"/>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock Text="进度节流间隔 (毫秒):" VerticalAlignment="Center"/>
        <NumericUpDown Grid.Column="1" Value="{Binding ThrottleIntervalMilliseconds}" Minimum="100" Increment="50" FormatString="0"
                       ToolTip.Tip="进度信息更新到界面的最小间隔 (毫秒). 数值越大界面刷新越少、性能越好, 数值越小进度显示越精确但开销越大, 保存后重启生效"/>
        <TextBlock Grid.Row="1" Text="日志级别:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"
                  ToolTip.Tip="写入日志文件的最低级别, 选择 None 表示不写日志文件, 保存后重启生效"/>
      </Grid>
      <Button Content="{Binding SaveButtonText}" Command="{Binding SaveUIOptionsCommand}" HorizontalAlignment="Left"
              Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>

      <Separator/>

      <!-- 主题 -->
      <TextBlock Text="主题 (即时生效)" FontWeight="Bold"
                 Foreground="{DynamicResource TitleForegroundBrush}"/>
      <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"
                HorizontalAlignment="Left" MinWidth="140"
                ToolTip.Tip="切换界面配色模式: 跟随系统 / 浅色 / 深色, 修改后立即生效并自动保存">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="models:ThemeMode">
            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}"/>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Separator/>

      <!-- 日志 -->
      <TextBlock Text="日志" FontWeight="Bold"
                 Foreground="{DynamicResource TitleForegroundBrush}"/>
      <Button Content="{Binding LogsButtonText}" Command="{Binding OpenLogsFolderCommand}" HorizontalAlignment="Left"
              ToolTip.Tip="{Binding LogsFolderTip}"
              Background="{DynamicResource PrimaryButtonBackgroundBrush}" Foreground="{DynamicResource PrimaryButtonForegroundBrush}"/>

      <Separator/>

      <!-- 关于 -->
      <TextBlock Text="关于" FontWeight="Bold"
                 Foreground="{DynamicResource TitleForegroundBrush}"/>
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="4">
        <TextBlock Text="产品:"/>
        <TextBlock Grid.Column="1" Text="{Binding ProductName}"/>
        <TextBlock Grid.Row="1" Text="版本:"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Version}"/>
        <TextBlock Grid.Row="2" Text="作者:"/>
        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Author}"/>
        <TextBlock Grid.Row="3" Text="许可证:"/>
        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding License}"/>
        <TextBlock Grid.Row="4" Text="GitHub:"/>
        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding GitHubUrl}"
                   Foreground="{DynamicResource TitleForegroundBrush}" TextDecorations="Underline"
                   Cursor="Hand" VerticalAlignment="Center" PointerPressed="OnGitHubLinkPressed"/>
      </Grid>

    </StackPanel>
  </ScrollViewer>

    <!-- 右下角 Toast 通知 -->
    <views:ToastView/>

  </Panel>

</Window>
