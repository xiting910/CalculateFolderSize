<UserControl x:Class="CalculateFolderSize.UI.Shared.Views.DirectoryPickerView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CalculateFolderSize.UI.Shared.ViewModels"
             xmlns:core="using:CalculateFolderSize.Core.Models"
             x:DataType="vm:DirectoryPickerViewModel"
             Width="420" Height="520"
             Background="{DynamicResource WindowBackgroundBrush}">

  <Panel>
    <Grid RowDefinitions="Auto,Auto,*,Auto">

      <!-- 当前路径 -->
      <TextBlock Text="{Binding CurrentPath}" Margin="8,8,8,4" TextWrapping="Wrap"/>

      <!-- 操作按钮 -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="8,4">
        <Button Content="上一级" Command="{Binding GoUpCommand}" IsEnabled="{Binding CanGoUp}"/>
        <Button Content="选择此目录" Click="OnConfirmClick"/>
        <Button Content="取消" Click="OnCancelClick"/>
      </StackPanel>

      <!-- 子文件夹列表, 双击进入 -->
      <ListBox Grid.Row="2" ItemsSource="{Binding Directories}" Margin="8,4"
               DoubleTapped="OnDirectoryDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="core:DirectoryEntry">
            <TextBlock Text="{Binding Name}"/>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

    </Grid>
  </Panel>

</UserControl>
